---
layout: base.njk
pagination: { data: catalog.toolPages.now, size: 1, alias: p }
permalink: "{{ p.url }}"
---
{%- set ui = site.ui[p.lang] -%}
<nav class="crumbs"><a href="{{ '/' if p.lang == 'nl' else '/en/' }}">{{ ui.home }}</a> › {{ p.title }}</nav>
<article class="topic wide" id="now" data-lang="{{ p.lang }}" data-ui="{{ { "diff": ui.nowDiff, "good": ui.nowGood, "bad": ui.nowBad, "fail": ui.nowWeatherFail, "air": ui.air, "airLabel": ui.nowAir, "wx": ui.wx } | json }}" data-cities="{{ site.weatherCities | json }}" data-rate="{{ rate.inr }}">
  <h1>{{ p.tool.icon }} {{ p.title }}</h1>
  <p class="intro">{{ p.description }}</p>

  <h2>{{ ui.nowClock }}</h2>
  <div class="clocks">
    <div class="clock nl"><small>{{ ui.calNl }}</small><b id="clock-nl">–</b><span id="date-nl"></span></div>
    <div class="clock in"><small>{{ ui.calIn }}</small><b id="clock-in">–</b><span id="date-in"></span></div>
  </div>
  <p id="now-diff"></p>

  <h2>{{ ui.nowCall }}</h2>
  <p id="now-call" class="callnow"></p>
  <div class="scroll"><table class="hours" id="now-hours" data-nl="{{ ui.nowCallNl }}" data-in="{{ ui.nowCallIn }}"></table></div>
  <p class="meta">{{ ui.nowCallIntro }}</p>

  <h2>{{ ui.nowWeather }}</h2>
  <div class="weather" id="now-weather"><p class="meta">…</p></div>
  <p class="meta">{{ ui.nowWeatherSrc }} · <a href="https://open-meteo.com/" rel="noopener">open-meteo.com</a></p>

  {%- if rate.inr %}
  <h2>{{ ui.nowRate }}</h2>
  <div class="rate">
    <label>€ <input type="number" id="rate-eur" value="100" min="0" step="any" inputmode="decimal"></label>
    <span>=</span>
    <label>₹ <input type="number" id="rate-inr" min="0" step="any" inputmode="decimal"></label>
  </div>
  <p class="meta">{{ ui.nowRateSrc }} {{ rate.date | date(p.lang) }}. {{ ui.nowRateNote }}</p>
  {%- endif %}
</article>
