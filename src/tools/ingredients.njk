---
layout: base.njk
pagination: { data: catalog.toolPages.ingredients, size: 1, alias: p }
permalink: "{{ p.url }}"
---
{%- set ui = site.ui[p.lang] -%}
<nav class="crumbs"><a href="{{ '/' if p.lang == 'nl' else '/en/' }}">{{ ui.home }}</a> › {{ p.title }}</nav>
<article class="topic">
  <h1>{{ p.tool.icon }} {{ p.title }}</h1>
  <p class="intro">{{ p.description }}</p>
  <div class="finder-bar">
    <input type="search" id="finder-q" placeholder="{{ ui.ingredientPh }}" aria-label="{{ ui.ingredientPh }}">
    <span><b id="finder-n">{{ catalog.ingredients.length }}</b> {{ ui.results }}</span>
  </div>
  <div class="scroll">
  <table class="years words">
    <thead><tr><th>{{ ui.ingredientIn }}</th><th>Nederlands</th><th>English</th></tr></thead>
    <tbody id="finder-list">
    {%- for x in catalog.ingredients %}
    <tr data-s="{{ (x[0] + ' ' + x[1] + ' ' + x[2]) | lower }}"><th>{{ x[0] }}</th><td>{{ x[1] }}</td><td>{{ x[2] }}</td></tr>
    {%- endfor %}
    </tbody>
  </table>
  </div>
  <p class="meta">{{ ui.ingredientNote }}</p>
</article>
