---
layout: base.njk
pagination: { data: catalog.toolPages.calendar, size: 1, alias: p }
permalink: "{{ p.url }}"
---
{%- set ui = site.ui[p.lang] -%}
{%- set cal = catalog.calendar[p.lang] -%}
{%- macro yearTable(rows, head) %}
<div class="scroll">
<table class="years">
  <thead><tr><th>{{ head }}</th>{% for y in cal.years %}<th>{{ y }}</th>{% endfor %}</tr></thead>
  <tbody>
  {%- for r in rows %}
  <tr><th>{{ r.name }}{% if r.note %}<small>{{ r.note }}</small>{% endif %}</th>{% for d in r.dates %}<td>{{ d | day(p.lang, true) }}</td>{% endfor %}</tr>
  {%- endfor %}
  </tbody>
</table>
</div>
{%- endmacro %}
<nav class="crumbs"><a href="{{ '/' if p.lang == 'nl' else '/en/' }}">{{ ui.home }}</a> › {{ p.title }}</nav>
<article class="topic wide">
  <h1>{{ p.tool.icon }} {{ p.title }}</h1>
  <p class="intro">{{ p.description }}</p>

  <h2>{{ ui.calUpcoming }}</h2>
  <ul class="upcoming" id="upcoming" data-ui="{{ { "today": ui.today, "tomorrow": ui.tomorrow, "inDays": ui.inDays } | json }}">
    {%- for d in cal.upcoming %}
    <li class="k-{{ d.kind }}" data-date="{{ d.date }}">
      <time datetime="{{ d.date }}">{{ d.date | day(p.lang) }}</time>
      <b>{{ d.name }}</b>
      <span>{% if d.kind == "nl" %}{{ ui.calNl }}{% elif d.kind == "in" %}{{ ui.calIn }}{% else %}{{ d.note }}{% endif %}</span>
    </li>
    {%- endfor %}
  </ul>

  <h2>{{ ui.calFestivals }}</h2>
  {{ yearTable(cal.festivals, ui.calFest) }}

  <h2>{{ ui.calHolidays }}</h2>
  {{ yearTable(cal.nl, ui.calNl) }}
  {{ yearTable(cal.in, ui.calIn) }}

  <p class="meta">{{ ui.calNote }}</p>
</article>
