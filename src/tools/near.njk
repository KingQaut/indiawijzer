---
layout: base.njk
pagination: { data: catalog.toolPages.near, size: 1, alias: p }
permalink: "{{ p.url }}"
---
{%- set ui = site.ui[p.lang] -%}
<nav class="crumbs"><a href="{{ '/' if p.lang == 'nl' else '/en/' }}">{{ ui.home }}</a> › {{ p.title }}</nav>
<h1>{{ p.tool.icon }} {{ p.title }}</h1>
<p class="intro">{{ p.description }}</p>
<link rel="stylesheet" href="/assets/vendor/leaflet/leaflet.css">
<link id="near-places" rel="preload" as="fetch" crossorigin href="/assets/places.json">
<link id="near-towns" rel="preload" as="fetch" crossorigin href="/assets/towns.json">
<link id="near-leaflet" rel="prefetch" href="/assets/vendor/leaflet/leaflet.js">
<section id="near" class="near" data-ui="{{ { "start": ui.nearStart, "none": ui.nearNone, "unknown": ui.nearUnknown, "denied": ui.nearDenied, "website": ui.website, "map": ui.map, "results": ui.results } | json }}" data-kinds="{{ catalog.kinds[p.lang] | json }}">
  <form class="near-bar" onsubmit="return false">
    <label>{{ ui.nearTown }}
      <input type="search" id="near-q" list="near-list" placeholder="{{ ui.nearTownPh }}" autocomplete="off">
    </label>
    <datalist id="near-list"></datalist>
    <label>{{ ui.nearRadius }}
      <select id="near-r"><option value="3">3 km</option><option value="10" selected>10 km</option><option value="25">25 km</option><option value="50">50 km</option></select>
    </label>
    <button type="button" class="btn" id="near-me">📍 {{ ui.nearMe }}</button>
  </form>
  <p class="near-kinds">
    {%- for k in catalog.kinds[p.lang] %}
    <label><input type="checkbox" value="{{ k.key }}" checked> <i class="dot" style="background:{{ k.color }}"></i> {{ k.label }}</label>
    {%- endfor %}
  </p>
  <div id="near-map" class="near-map" hidden></div>
  <p id="near-msg" class="meta">{{ ui.nearStart }}</p>
  <div id="near-out"></div>
  <p class="meta">{{ ui.nearPrivacy }} {{ ui.osm }} · {{ ui.updated }} {{ places.updated | date(p.lang) }}</p>
</section>
<p><a href="{{ catalog.tools[p.lang][1].url }}">{{ catalog.tools[p.lang][1].title }} →</a></p>
