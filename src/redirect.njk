---
pagination: { data: catalog.redirects, size: 1, alias: r }
permalink: "{{ r.from }}"
eleventyExcludeFromCollections: true
---
<!doctype html>
<html><head><meta charset="utf-8"><title>{{ r.title }}</title>
<link rel="canonical" href="{{ site.url }}{{ r.to }}">
<meta http-equiv="refresh" content="0; url={{ r.to }}">
<meta name="robots" content="noindex">
</head><body><p><a href="{{ r.to }}">{{ r.title }}</a></p></body></html>
