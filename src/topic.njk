---
layout: base.njk
pagination: { data: catalog.topicPages, size: 1, alias: p }
permalink: "{{ p.url }}"
---
{%- from "placelist.njk" import placeList -%}
{%- set ui = site.ui[p.lang] -%}
{%- set t = p.topic -%}
<nav class="crumbs"><a href="{{ '/' if p.lang == 'nl' else '/en/' }}">{{ ui.home }}</a> › <a href="{{ p.section.url }}">{{ p.section.title }}</a> › {{ t.title }}</nav>
<article class="topic">
  <h1>{{ t.title }}</h1>
  <p class="intro">{{ t.intro }}</p>
  {%- for para in t.body %}
  <p>{{ para }}</p>
  {%- endfor %}

  {%- if t.live.length %}
  <h2>{{ ui.live }}</h2>
  <p class="buttons">
    {%- for x in t.live %}
    <a class="btn" href="{{ x.u }}" rel="noopener">{{ x.t }} ↗</a>
    {%- endfor %}
  </p>
  {%- endif %}

  {%- if t.links.length %}
  <h2>{{ ui.links }}</h2>
  <ul class="links">
    {%- for x in t.links %}
    <li><a href="{{ x.u }}" rel="noopener">{{ x.t }}</a> <small>{{ x.u | host }}</small>{% if x.d %}<br><span>{{ x.d }}</span>{% endif %}</li>
    {%- endfor %}
  </ul>
  {%- endif %}

  {%- if t.finder %}
  {%- set fromWiki = wiki[t.finder] %}
  {%- set list = fromWiki or places[t.finder] %}
  <section class="finder">
    {%- if list.length %}
    <div class="finder-bar">
      <input type="search" id="finder-q" placeholder="{{ ui.filterPh }}" aria-label="{{ ui.filterPh }}">
      <span><b id="finder-n">{{ list.length }}</b> {{ ui.results }}</span>
    </div>
    {{ placeList(list, ui, "finder-list") }}
    <p class="meta">{% if fromWiki %}{{ ui.wikidata }} · {{ ui.updated }} {{ wiki.updated | date(p.lang) }}{% else %}{{ ui.osm }} · {{ ui.updated }} {{ places.updated | date(p.lang) }}{% endif %}</p>
    {%- else %}
    <p class="meta">{{ ui.finderEmpty }}</p>
    {%- endif %}
  </section>
  {%- endif %}
</article>
<aside class="more">
  <h2>{{ ui.seeAlso }}: {{ p.section.title }}</h2>
  <p>
  {%- for o in p.section.topics %}{% if o.url != t.url %}<a class="chip" href="{{ o.url }}">{{ o.title }}</a> {% endif %}{% endfor -%}
  </p>
</aside>
