---
layout: base.njk
pagination: { data: catalog.homePages, size: 1, alias: p }
permalink: "{{ p.url }}"
---
{%- set ui = site.ui[p.lang] -%}
<h1 class="sr">{{ site.name }} – {{ ui.tagline }}</h1>
<div class="split">
{%- for h in catalog.home[p.lang] %}
  <section class="half {{ h.side }}">
    <span class="sun" aria-hidden="true"></span>
    {% include "skyline-" + h.side + ".svg" %}
    <small>{{ h.kicker }}</small>
    <h2>{{ h.title }}</h2>
    <p>{{ h.text }}</p>
    <ul>
    {%- for l in h.links %}
      <li><a href="{{ l.url }}"><i aria-hidden="true">{{ l.icon }}</i> {{ l.title }}</a></li>
    {%- endfor %}
    </ul>
    <p class="all">{% for s in h.more %}<a href="{{ s.url }}">{{ s.title }} →</a>{% endfor %}</p>
  </section>
{%- endfor %}
</div>
<div class="grid">
{%- for s in catalog.rest[p.lang] %}
  <section class="card">
    <h2><a href="{{ s.url }}"><span class="ico" aria-hidden="true">{{ s.icon }}</span> {{ s.title }}</a></h2>
    <p>{{ s.intro }}</p>
    <ul>
    {%- for t in s.topics %}
      <li><a href="{{ t.url }}">{{ t.title }}</a></li>
    {%- endfor %}
    </ul>
  </section>
{%- endfor %}
  <section class="card">
    <h2><span class="ico" aria-hidden="true">🧭</span> {{ ui.tools }}</h2>
    <p>{{ ui.toolsIntro }}</p>
    <ul>
    {%- for t in catalog.tools[p.lang] %}
      <li><a href="{{ t.url }}">{{ t.title }}</a></li>
    {%- endfor %}
    </ul>
  </section>
  <section class="card">
    <h2><a href="{{ catalog.urls.news[p.lang] }}"><span class="ico" aria-hidden="true">📰</span> {{ ui.latest }}</a></h2>
    {%- set items = news[p.lang] %}
    {%- if items.length %}
    <ul class="headlines">
    {%- for n in items.slice(0, 4) %}
      <li><a href="{{ n.link }}" rel="noopener nofollow">{{ n.title }}</a> <small>{{ n.source }}</small></li>
    {%- endfor %}
    </ul>
    <p><a href="{{ catalog.urls.news[p.lang] }}">{{ ui.allNews }} →</a></p>
    {%- else %}
    <p>{{ ui.newsIntro }}</p>
    {%- endif %}
  </section>
</div>
